// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String

  firstName String?
  lastName  String?

  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId String  @unique
  state  String?

  firstName String?
  lastName  String?
  channel String?
  Word      Word[]

  @@map("customers")
}

model Word {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  word         String
  translation  String
  needToLearn  Boolean    @default(true)
  videoExample String?
  imageExample String?
  examples     String?
  
  repeatCount       Int       @default(0)
  lastRepeatAt     DateTime?
  lastNotificationAt DateTime?
  nextRepeatDate    DateTime?
  
  repetitions      WordRepetition[]

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, word])
  @@map("words")
}

model WordRepetition {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id])

  success   Boolean  @default(false)
  
  intervalNumber Int  @default(1)

  @@map("word_repetitions")
}
