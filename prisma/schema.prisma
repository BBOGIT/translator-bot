
generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email String @unique
  hash  String
  hashedRt String?

  firstName String?
  lastName  String?

  @@map("users")
}

model Customer {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chatId String  @unique
  state  String?

  firstName String?
  lastName  String?
  channel String?
  repetitionTime String?
  Word      Word[]

  @@index([state])
  @@map("customers")
}

model Word {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  word         String
  translation  String
  needToLearn  Boolean    @default(true)
  videoExample String?
  imageExample String?
  examples     String?
  
  repeatCount       Int       @default(0)
  lastRepeatAt     DateTime?
  lastNotificationAt DateTime?
  nextRepeatDate    DateTime?
  
  repetitions      WordRepetition[]

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, word])
  @@index([customerId, needToLearn])
  @@index([needToLearn, lastNotificationAt])
  @@index([updatedAt])
  @@map("words")
}

model WordRepetition {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  wordId    Int
  word      Word     @relation(fields: [wordId], references: [id])

  success   Boolean  @default(false)
  
  intervalNumber Int  @default(1)

  @@index([wordId])
  @@index([createdAt])
  @@map("word_repetitions")
}

model ChannelExtractionConfig {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelId          String  @unique
  channelTitle       String?
  channelUsername    String?
  
  wordRegex          String
  translationRegex   String
  examplesRegex      String
  
  isActive           Boolean @default(true)
  createdByAI        Boolean @default(false)
  
  @@index([channelId])
  @@index([isActive])
  @@map("channel_extraction_configs")
}
